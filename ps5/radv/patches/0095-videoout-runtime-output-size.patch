+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The PS5 VideoOut output's geometry, from PS5_VIDEOOUT_SIZE (the launcher's
+ * Output resolution): the extent the display reports and a swapchain takes,
+ * the framebuffers' scanout extent, and the region of the scanout the image
+ * fills. A 16:9 extent is the scanout itself, and VideoOut's scaler fills the
+ * screen. A 16:10 extent cannot be scanned out without a stretch, so each
+ * present scales the image into a centred 16:10 region of the 4K scanout;
+ * the columns beside it stay as the framebuffers were registered, zeroed:
+ * black. Plain C without Vulkan or Mesa, so host tests compile it as is.
+ */
+
+#ifndef WSI_COMMON_VIDEOOUT_GEOMETRY_H
+#define WSI_COMMON_VIDEOOUT_GEOMETRY_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+/* The largest scanout, and the one 16:10 output sizes are drawn into. */
+#define VIDEOOUT_WIDTH 3840
+#define VIDEOOUT_HEIGHT 2160
+
+#ifndef VK_VERSION_1_0
+typedef struct VkExtent2D {
+   uint32_t width, height;
+} VkExtent2D;
+typedef struct VkOffset2D {
+   int32_t x, y;
+} VkOffset2D;
+#endif
+
+struct videoout_geometry {
+   VkExtent2D extent, scanout, region;
+   VkOffset2D offset;
+};
+
+/* The geometry setting names; NULL or empty is 3840x2160. false (and
+ * 3840x2160) for a size that is not one of the launcher's. */
+static inline bool
+videoout_geometry_parse(const char *setting, struct videoout_geometry *g)
+{
+   static const struct {
+      const char *name;
+      uint32_t width, height;
+   } sizes[] = {
+      {"3840x2160", 3840, 2160}, {"2560x1440", 2560, 1440}, {"1920x1080", 1920, 1080},
+      {"2560x1600", 2560, 1600}, {"1920x1200", 1920, 1200}, {"1280x800", 1280, 800},
+   };
+   uint32_t chosen = 0;
+   bool known = setting == NULL || setting[0] == '\0';
+   for (uint32_t i = 0; !known && i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+      if (strcmp(setting, sizes[i].name) == 0) {
+         chosen = i;
+         known = true;
+      }
+   }
+   g->extent = (VkExtent2D){sizes[chosen].width, sizes[chosen].height};
+   if ((uint64_t)g->extent.width * 9 == (uint64_t)g->extent.height * 16) {
+      g->scanout = g->region = g->extent;
+      g->offset = (VkOffset2D){0, 0};
+   } else {
+      g->scanout = (VkExtent2D){VIDEOOUT_WIDTH, VIDEOOUT_HEIGHT};
+      g->region = (VkExtent2D){VIDEOOUT_HEIGHT * g->extent.width / g->extent.height, VIDEOOUT_HEIGHT};
+      g->offset = (VkOffset2D){(int32_t)(VIDEOOUT_WIDTH - g->region.width) / 2, 0};
+   }
+   return known;
+}
+
+/* Whether a present scales the image into a region of a larger scanout. */
+static inline bool
+videoout_geometry_needs_blit(const struct videoout_geometry *g)
+{
+   return g->extent.width != g->scanout.width || g->extent.height != g->scanout.height;
+}
+
+/* The cursor plane's position in scanout pixels for (x, y) in a space of
+ * space_width x space_height that covers the whole image: the region,
+ * never the bars beside it. The caller rejects an empty space. */
+static inline void
+videoout_geometry_cursor(const struct videoout_geometry *g, int x, int y, int space_width,
+                         int space_height, int *scanout_x, int *scanout_y)
+{
+   int64_t sx = (int64_t)x * g->region.width / space_width;
+   int64_t sy = (int64_t)y * g->region.height / space_height;
+   sx = sx < 0 ? 0 : sx > (int64_t)g->region.width - 1 ? (int64_t)g->region.width - 1 : sx;
+   sy = sy < 0 ? 0 : sy > (int64_t)g->region.height - 1 ? (int64_t)g->region.height - 1 : sy;
+   *scanout_x = g->offset.x + (int)sx;
+   *scanout_y = g->offset.y + (int)sy;
+}
+
+#endif
