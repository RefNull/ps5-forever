From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rhys Perry <pendingchaos02@gmail.com>
Date: Mon, 19 Oct 2026 16:24:43 +0100
Subject: [PATCH] aco/opt_postRA: check for tied defs in
 try_optimize_branching_sequence

Signed-off-by: Rhys Perry <pendingchaos02@gmail.com>
Closes: https://gitlab.freedesktop.org/mesa/mesa/-/work_items/16618
Fixes: 984aa6e0855 ("aco/ra: create s_bitset")
Reviewed-by: Georg Lehmann <dadschoorse@gmail.com>
(cherry picked from commit 81274cd2fe1a0616ec756704c61a29bcc74c2e9d)

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45704>
(cherry picked from commit 56b5460171f91afda0b9c7b196df738bffc34b79)
---
 src/amd/compiler/aco_ir.cpp                  |  2 +-
 src/amd/compiler/aco_ir.h                    |  2 +-
 src/amd/compiler/aco_optimizer_postRA.cpp    | 18 +++++++++++++++++-
 src/amd/compiler/aco_register_allocation.cpp |  2 +-
 4 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/src/amd/compiler/aco_ir.cpp b/src/amd/compiler/aco_ir.cpp
index 8754997a1a3..dbe5877c220 100644
--- a/src/amd/compiler/aco_ir.cpp
+++ b/src/amd/compiler/aco_ir.cpp
@@ -660,7 +660,7 @@ can_use_opsel(amd_gfx_level gfx_level, aco_opcode op, int idx)
 }
 
 bool
-can_write_m0(const aco_ptr<Instruction>& instr)
+can_write_m0(const Instruction* instr)
 {
    if (instr->isSALU())
       return true;
diff --git a/src/amd/compiler/aco_ir.h b/src/amd/compiler/aco_ir.h
index d4e5777e089..d48368cdb95 100644
--- a/src/amd/compiler/aco_ir.h
+++ b/src/amd/compiler/aco_ir.h
@@ -2068,7 +2068,7 @@ SubdwordCaps get_subdword_definition_caps(Program* program, const Instruction* i
 
 bool opcode_supports_dpp(amd_gfx_level gfx_level, aco_opcode opcode, bool vop3p);
 bool can_use_DPP(amd_gfx_level gfx_level, const aco_ptr<Instruction>& instr, bool dpp8);
-bool can_write_m0(const aco_ptr<Instruction>& instr);
+bool can_write_m0(const Instruction* instr);
 /* updates "instr" and returns the old instruction (or NULL if no update was needed) */
 aco_ptr<Instruction> convert_to_SDWA(amd_gfx_level gfx_level, aco_ptr<Instruction>& instr);
 aco_ptr<Instruction> convert_to_DPP(amd_gfx_level gfx_level, aco_ptr<Instruction>& instr,
diff --git a/src/amd/compiler/aco_optimizer_postRA.cpp b/src/amd/compiler/aco_optimizer_postRA.cpp
index b2cb6388235..cbb0a5117cc 100644
--- a/src/amd/compiler/aco_optimizer_postRA.cpp
+++ b/src/amd/compiler/aco_optimizer_postRA.cpp
@@ -963,6 +963,20 @@ is_nop_copy(Instruction* instr)
    }
 }
 
+bool
+can_rewrite_def(pr_opt_ctx& ctx, Instruction* instr, unsigned def_idx, PhysReg reg)
+{
+   if (reg == m0 && !can_write_m0(instr))
+      return false;
+
+   const aco_alu_opcode_info& opcode_info = instr_info.alu_opcode_infos[(int)instr->opcode];
+   fixed_reg fixed = opcode_info.get_def_fixed_reg(instr, ctx.program->gfx_level, def_idx);
+   if (fixed != not_fixed && reg != instr->definitions[def_idx].physReg())
+      return false;
+
+   return def_idx >= get_tied_defs(instr).size();
+}
+
 bool
 try_optimize_branching_sequence(pr_opt_ctx& ctx, aco_ptr<Instruction>& exec_copy)
 {
@@ -1069,11 +1083,13 @@ try_optimize_branching_sequence(pr_opt_ctx& ctx, aco_ptr<Instruction>& exec_copy
     * Note, VOPC implicitly contains "& exec" because it yields zero on inactive lanes.
     * Additionally, when value is copied as-is, also allow SALU and parallelcopies.
     */
-   const bool can_reassign =
+   bool can_reassign =
       vopc || (exec_copy->opcode == aco_opcode::p_parallelcopy &&
                (exec_val->isSALU() || exec_val->opcode == aco_opcode::p_parallelcopy ||
                 exec_val->opcode == aco_opcode::p_create_vector));
 
+   can_reassign &= vopc || can_rewrite_def(ctx, exec_val, 0, exec);
+
    /* The reassignment is not worth it when both the original exec needs to be copied
     * and the new exec copy can't be removed. In this case we'd end up with more instructions.
     */
diff --git a/src/amd/compiler/aco_register_allocation.cpp b/src/amd/compiler/aco_register_allocation.cpp
index 50bf1bc1550..efbe1b0753f 100644
--- a/src/amd/compiler/aco_register_allocation.cpp
+++ b/src/amd/compiler/aco_register_allocation.cpp
@@ -1492,7 +1492,7 @@ get_reg_specified(ra_ctx& ctx, const RegisterFile& reg_file, RegClass rc,
    /* VCC is outside the bounds */
    bool is_vcc =
       info.rc.type() == RegType::sgpr && vcc_win.contains(reg_win) && ctx.program->needs_vcc;
-   bool is_m0 = info.rc == s1 && reg == m0 && can_write_m0(instr);
+   bool is_m0 = info.rc == s1 && reg == m0 && can_write_m0(instr.get());
    if (!info.bounds.contains(reg_win) && !is_vcc && !is_m0)
       return false;
 
-- 
