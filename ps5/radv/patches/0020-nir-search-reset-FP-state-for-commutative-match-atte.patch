From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jan Meisel <meisel.jan.magnus@gmail.com>
Date: Mon, 3 Aug 2026 23:18:08 +0200
Subject: [PATCH] nir/search: reset FP state for commutative match attempts

Each commutative direction is an independent match attempt. variables_seen is
already reset between attempts, but fp_math_ctrl was initialized only once
and accumulated flags from failed directions.

This can incorrectly mark replacement instructions exact or otherwise
restrict their FP behavior. Reset fp_math_ctrl together with the other
per-attempt state and add a regression test where the first direction
descends through an exact instruction before the second direction succeeds
without it.

Cc: mesa-stable

Reviewed-by: Georg Lehmann <dadschoorse@gmail.com>
Assisted-by: Codex
Signed-off-by: Jan Meisel <meisel.jan.magnus@gmail.com>
(cherry picked from commit e1c6bf8d20713261c2cba57b59b93cc5e75d08e4)

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/43884>
(cherry picked from commit ed2598c453a5f34a36e08f9892a5b7b2029cc3ea)
---
 src/compiler/nir/nir_search.c              |  2 +-
 src/compiler/nir/tests/algebraic_tests.cpp | 20 ++++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/compiler/nir/nir_search.c b/src/compiler/nir/nir_search.c
index b6e08018a91..b4443cd4381 100644
--- a/src/compiler/nir/nir_search.c
+++ b/src/compiler/nir/nir_search.c
@@ -648,7 +648,6 @@ nir_replace_instr(nir_builder *build, nir_alu_instr *instr,
                   struct exec_list *dead_instrs)
 {
    struct match_state state;
-   state.fp_math_ctrl = nir_fp_fast_math;
    state.state = search_state;
    state.pass_op_table = table->pass_op_table;
    state.table = table;
@@ -664,6 +663,7 @@ nir_replace_instr(nir_builder *build, nir_alu_instr *instr,
        * binary.
        */
       state.comm_op_direction = comb;
+      state.fp_math_ctrl = nir_fp_fast_math;
       state.variables_seen = 0;
 
       if (match_expression(table, search, instr,
diff --git a/src/compiler/nir/tests/algebraic_tests.cpp b/src/compiler/nir/tests/algebraic_tests.cpp
index 04ef6824d30..20829f7513f 100644
--- a/src/compiler/nir/tests/algebraic_tests.cpp
+++ b/src/compiler/nir/tests/algebraic_tests.cpp
@@ -186,6 +186,26 @@ TEST_F(nir_opt_algebraic_test, msad)
    require_one_alu(nir_op_msad_4x8);
 }
 
+TEST_F(nir_opt_algebraic_test, commutative_match_does_not_leak_fp_math_ctrl)
+{
+   nir_def *src = nir_load_var(
+      b, nir_local_variable_create(b->impl, glsl_float_type(), "src"));
+   nir_def *inner = nir_fneg(b, src);
+   nir_def_as_alu(inner)->fp_math_ctrl = nir_fp_exact;
+   nir_def *outer = nir_fneg(b, inner);
+   nir_def *result = nir_fmin(b, outer, inner);
+   nir_variable *result_var =
+      nir_local_variable_create(b->impl, glsl_float_type(), "result");
+   nir_intrinsic_instr *store = nir_build_store_deref(
+      b, &nir_build_deref_var(b, result_var)->def, result, 0x1);
+
+   ASSERT_TRUE(nir_opt_algebraic(b->shader));
+   nir_alu_instr *optimized = nir_src_as_alu(store->src[1]);
+   ASSERT_NE(optimized, nullptr);
+   EXPECT_EQ(optimized->op, nir_op_fneg);
+   EXPECT_EQ(optimized->fp_math_ctrl & nir_fp_exact, 0);
+}
+
 TEST_F(nir_opt_mqsad_test, mqsad)
 {
    options.lower_bitfield_extract = true;
